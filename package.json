{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow: a task management REST API with JWT auth, built to run through a full Jenkins DevOps pipeline",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "APP_ENV=development node src/server.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:report": "eslint . --max-warnings 0 -f json -o reports/eslint-report.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.0.0"
  }
}
